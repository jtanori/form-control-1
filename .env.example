# ── Brain (packages/brain) ────────────────────────────────────────────────────
# Copy to .env (gitignored) or export in your shell. Never commit real values.
# Run with zero key:  MOCK_LLM=1 pnpm --filter @vfe/brain dev
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
LLM_PROVIDER=openai        # openai | groq | anthropic | mock
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0
LLM_TIMEOUT_MS=8000
BRAIN_PORT=8787
BRAIN_AUTH_TOKEN=
CACHE_TTL_MS=600000
RATE_LIMIT_PER_MINUTE=60
LOG_LEVEL=info
MOCK_LLM=false

# ── Edge proxy (C-3) ─────────────────────────────────────────────────────────
EDGE_PORT=8788
EDGE_BRAIN_URL=http://localhost:8787
EDGE_SESSION_SECRET=change-me-at-least-32-characters-long
ALLOWED_EXTENSION_IDS=
STT_PROVIDER=groq          # groq | deepgram
DEEPGRAM_API_KEY=
MOCK_STT=false
