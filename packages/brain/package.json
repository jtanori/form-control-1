{
  "name": "@vfe/brain",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./edge": {
      "types": "./dist/edge/server.d.ts",
      "import": "./dist/edge/server.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "dev": "tsx watch src/server.ts",
    "dev:edge": "tsx watch src/edge/server.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "eval": "tsx src/evals/cli.ts",
    "eval:live": "LIVE=1 tsx src/evals/cli.ts",
    "eval:record": "RECORD=1 tsx src/evals/cli.ts",
    "clean": "rm -rf dist .turbo coverage"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@vfe/protocol": "workspace:*",
    "hono": "^4.6.11",
    "openai": "^4.73.0",
    "zod": "3.23.8",
    "zod-to-json-schema": "3.23.5"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2"
  }
}
